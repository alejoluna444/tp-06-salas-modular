<section>
    <h2><%= seccion %> - Nueva reserva</h2>

    <% if (error) { %>
        <div role="alert">
            <p><%= error %></p>
        </div>
    <% } %>

    <form action="/reservas" method="POST">

        <div>
            <label for="estudiante">Estudiante:</label>
            <input
                type="text"
                id="estudiante"
                name="estudiante"
                value="<%= datos.estudiante %>"
            >
        </div>

        <div>
            <label for="email">Email:</label>
            <input
                type="email"
                id="email"
                name="email"
                value="<%= datos.email %>"
            >
        </div>

        <div>
            <label for="sala">Sala:</label>
            <select id="sala" name="sala">
                <option value="">Seleccionar sala</option>

                <option value="Sala Norte"
                    <%= datos.sala === "Sala Norte" ? "selected" : "" %>>
                    Sala Norte
                </option>

                <option value="Sala Sur"
                    <%= datos.sala === "Sala Sur" ? "selected" : "" %>>
                    Sala Sur
                </option>

                <option value="Sala Multimedia"
                    <%= datos.sala === "Sala Multimedia" ? "selected" : "" %>>
                    Sala Multimedia
                </option>
            </select>
        </div>

        <div>
            <label for="fecha">Fecha:</label>
            <input
                type="text"
                id="fecha"
                name="fecha"
                value="<%= datos.fecha %>"
                placeholder="Ejemplo: 2026-09-30"
            >
        </div>

        <div>
            <label for="turno">Turno:</label>
            <select id="turno" name="turno">
                <option value="">Seleccionar turno</option>

                <option value="Mañana"
                    <%= datos.turno === "Mañana" ? "selected" : "" %>>
                    Mañana
                </option>

                <option value="Tarde"
                    <%= datos.turno === "Tarde" ? "selected" : "" %>>
                    Tarde
                </option>

                <option value="Noche"
                    <%= datos.turno === "Noche" ? "selected" : "" %>>
                    Noche
                </option>
            </select>
        </div>

        <div>
            <label for="personas">Cantidad de personas:</label>
            <input
                type="number"
                id="personas"
                name="personas"
                value="<%= datos.personas %>"
            >
        </div>

        <button type="submit">Guardar reserva</button>

    </form>

    <p>
        <a href="/reservas">Volver a las reservas</a>
    </p>
</section>